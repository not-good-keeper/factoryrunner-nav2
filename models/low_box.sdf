<?xml version="1.0"?>
<!-- A 10 cm tall crate: entirely below the Waffle's 2D LiDAR plane (~0.17 m), so only the
     depth camera can see it. Used to show what the LiDAR-only costmaps miss. -->
<sdf version="1.9">
  <model name="low_box">
    <static>true</static>
    <link name="body">
      <collision name="collision">
        <geometry>
          <box><size>0.4 0.4 0.1</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.4 0.4 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.5 0.8 1</ambient>
          <diffuse>0.2 0.5 0.8 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
